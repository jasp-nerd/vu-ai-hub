# ---- Chat provider ----
# Requests use, in priority order: a per-user OpenAI key, OPENAI_API_KEY,
# then OpenRouter. Configure at least one.

# Your OpenAI API key (site-wide fallback for the AI chat).
OPENAI_API_KEY=
# Model used for the OpenAI provider (when no per-user model is set).
OPENAI_MODEL=gpt-4o-mini

# OpenRouter key + model (legacy fallback).
OPENROUTER_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b

# ---- Rate limiting (/api/chat) ----
# Fixed window: max requests per client IP within the window, in seconds.
RATE_LIMIT_CHAT_MAX=10
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# Vercel KV (shared rate-limit store). Without these, the limiter falls back
# to a per-instance in-memory store (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Sign in with ChatGPT (SIWC) ----
# Requires an approved OpenAI OAuth client (https://developers.openai.com/siwc/request-client-id).
# When unset, the sign-in button is disabled and the routes return 503.
OPENAI_OAUTH_CLIENT_ID=
# Only set for a confidential client (client_secret_basic); public clients omit it.
OPENAI_OAUTH_CLIENT_SECRET=
# Exact registered callback URL, e.g. https://vu-ai-hub.vercel.app/api/auth/openai/callback
OPENAI_OAUTH_REDIRECT_URI=
# Optional override for the OIDC discovery document.
# OPENAI_OIDC_DISCOVERY_URL=https://auth.openai.com/.well-known/openid-configuration

# Secret used to HMAC-sign the SIWC session and auth-transaction cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ---- Other (already in use) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_POSTHOG_KEY=
